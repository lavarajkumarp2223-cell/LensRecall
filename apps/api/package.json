{
  "name": "@lensrecall/api",
  "version": "0.0.1",
  "private": true,
  "description": "LensRecall API server (NestJS)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@lensrecall/db": "*",
    "@lensrecall/shared": "*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-fastify": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/swagger": "^11.2.0",
    "@aws-sdk/client-rekognition": "^3.809.0",
    "@aws-sdk/client-s3": "^3.809.0",
    "@aws-sdk/s3-request-presigner": "^3.809.0",
    "bullmq": "^5.56.2",
    "sharp": "^0.33.5",
    "qrcode": "^1.5.4",
    "resend": "^4.6.0",
    "ioredis": "^5.6.1",
    "zod": "^3.24.2",
    "bcrypt": "^5.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@lensrecall/config": "*",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.3",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  }
}
