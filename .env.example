# =============================================================================
# LENSRECALL — ENVIRONMENT VARIABLES REFERENCE
# =============================================================================
# Copy this file to .env in each app's directory and fill in real values.
# NEVER commit .env files with real secrets.
# =============================================================================

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
# development | staging | production

# ─── API (apps/api) ──────────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL=http://localhost:3001

# JWT
JWT_SECRET=replace-with-secure-random-secret-min-64-chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d

# ─── Web (apps/web) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Auth.js (NextAuth v5)
AUTH_SECRET=replace-with-secure-random-secret-min-32-chars
AUTH_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL=postgresql://lensrecall:password@localhost:5432/lensrecall_dev
DATABASE_POOL_MAX=10

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ─── Object Storage (Cloudflare R2 / S3-compatible) ──────────────────────────
STORAGE_PROVIDER=r2
# r2 | s3 | mock

# Cloudflare R2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=lensrecall-media
R2_PUBLIC_URL=https://your-r2-public-url.com

# AWS S3 (if using S3 instead)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET_NAME=lensrecall-media

# Signed URL defaults
STORAGE_SIGNED_URL_TTL_SECONDS=3600
# 1 hour default

# ─── Face Recognition (AWS Rekognition) ──────────────────────────────────────
FACE_RECOGNITION_PROVIDER=rekognition
# rekognition | azure | mock

# Rekognition
REKOGNITION_COLLECTION_PREFIX=lensrecall
# Collection IDs will be: lensrecall_{eventId}
REKOGNITION_REGION=ap-south-1
# Uses same AWS credentials as storage unless overridden:
# REKOGNITION_ACCESS_KEY_ID=
# REKOGNITION_SECRET_ACCESS_KEY=

# Face matching thresholds
FACE_SIMILARITY_THRESHOLD=80
# Rekognition: 0-100, recommend 75-85 for production
FACE_MAX_RESULTS=100

# ─── Email (Resend) ───────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend
# resend | ses | mock
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM_ADDRESS=noreply@lensrecall.com
EMAIL_FROM_NAME=LensRecall

# ─── Queue (BullMQ) ──────────────────────────────────────────────────────────
QUEUE_CONCURRENCY_IMAGE=5
QUEUE_CONCURRENCY_FACE_DETECTION=3
QUEUE_CONCURRENCY_FACE_EMBEDDING=3
QUEUE_CONCURRENCY_DOWNLOAD_ZIP=2
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_WINDOW_MS=900000
# 15 minutes
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_FACE_SEARCH_WINDOW_MS=60000
# 1 minute
RATE_LIMIT_FACE_SEARCH_MAX=5
RATE_LIMIT_UPLOAD_WINDOW_MS=3600000
# 1 hour
RATE_LIMIT_UPLOAD_MAX=500

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
PAYMENT_PROVIDER=stripe
# stripe | mock
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# ─── Image Processing ────────────────────────────────────────────────────────
IMAGE_THUMBNAIL_WIDTH=300
IMAGE_THUMBNAIL_HEIGHT=300
IMAGE_PREVIEW_MAX_WIDTH=1920
IMAGE_PREVIEW_QUALITY=85
IMAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif
IMAGE_MAX_SIZE_MB=50

# ─── QR Codes ─────────────────────────────────────────────────────────────────
QR_BASE_URL=http://localhost:3000/e
# Production: https://lensrecall.com/e

# ─── Observability ───────────────────────────────────────────────────────────
LOG_LEVEL=debug
# debug | info | warn | error

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Data Retention Defaults ─────────────────────────────────────────────────
DEFAULT_FACE_DATA_RETENTION_DAYS=90
DEFAULT_PHOTO_RETENTION_DAYS=365
DEFAULT_DOWNLOAD_ZIP_EXPIRY_HOURS=24

# ─── Super Admin ─────────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@lensrecall.com
